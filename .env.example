# Copy to .env.local and fill in. Never commit real values: the repository is public.

# OpenAI API key (server only)
OPENAI_API_KEY=

# Supabase transaction pooler, port 6543. Used by the app and the scripts.
DATABASE_URL=
# Supabase session pooler, port 5432. Used by drizzle-kit migrations only; not needed on Vercel.
DATABASE_URL_SESSION=

# Models (defaults in src/lib/env.ts)
GENERATION_MODEL=gpt-5.5
HELPER_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small

# Rerank relevance threshold, 0-10. Tuned by `npm run eval` (T-020).
RERANK_THRESHOLD=6

# Basic Auth for the whole app (src/proxy.ts). Share the password out of band.
DEMO_USER=
DEMO_PASSWORD=

# Production URL with https://, used by local test commands only.
DEMO_URL=
